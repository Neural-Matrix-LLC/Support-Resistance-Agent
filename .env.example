# Copy to .env (git-ignored). Every variable the code reads is listed here.

# Optional. Tiingo free-tier token (https://www.tiingo.com/), used only with
# `sr p0 --source tiingo`. The default source, yfinance, needs no token.
TIINGO_API_KEY=

# Root of the raw cache / lake. Default: ./data (git-ignored).
SR_DATA_DIR=data
